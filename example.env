# Server
PORT=5000
# Public URL of the API. Used to build the links inside emails
APP_URL=http://localhost:5000

# Database (MongoDB connection string, e.g. from MongoDB Atlas)
DB_URL=

# Redis (rate limiting + revoked tokens), e.g. from Redis Cloud: rediss://default:<password>@<host>:<port>
REDIS_URL=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Email (Gmail address + App Password, NOT your normal password)
EMAIL_USER=
EMAIL_PASSWORD=
